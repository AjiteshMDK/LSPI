{
    "Header": {
        "Caption": "$(L,measuring_points)"
    },
    "EmptySection": {
        "Caption": "$(L,no_measuring_points_available)"
    },
    "Footer": {
        "Caption": "$(L,see_all_data)",
        "AccessoryType": "DisclosureIndicator",
        "FooterStyle": "Attribute",
        "AttributeLabel": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointsCount.js",
        "OnPress": "/SAPAssetManager/Actions/Measurements/MeasuringPointsListViewNav.action"
    },
    "_Type": "Section.Type.ObjectTable",
    "_Name": "MeasuringPointsList",
    "DataSubscriptions": ["MeasurementDocuments",  "MeasuringPoints"],
    "MaxItemCount": 2,
    "ObjectCell": {
        "Title": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointListFieldFormat.js",
        "Subhead": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointFieldFormat.js",
        "StatusText": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointListFieldFormat.js",
        "Footnote": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointFieldFormat.js",
        "SubstatusText": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointListFieldFormat.js",
        "AccessoryType": "disclosureIndicator",
        "OnPress": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointDetailsNav.js",
        "PreserveIconStackSpacing": true,
        "Icons": "/SAPAssetManager/Rules/Measurements/Points/MeasuringPointIcons.js"
    },
    "Target": {
        "EntitySet": "{{#Property:@odata.readLink}}/MeasuringPoints",
        "Service": "/SAPAssetManager/Services/AssetManager.service",
        "QueryOptions": "$top=3&$orderby=SortField&$expand=MeasurementDocs,MeasurementDocs/MeasuringPoint&$select=Point,PointDesc,CharName,UoM,IsCounter,CodeGroup,CatalogType,PrevReadingDate,PrevReadingTime,PrevReadBy,PrevReadingValue,PrevHasReadingValue,PrevValuationCode,PrevCodeDescription,MeasurementDocs/ReadingDate,MeasurementDocs/ReadingTime,MeasurementDocs/CodeGroup,MeasurementDocs/ValuationCode,MeasurementDocs/CodeShortText,MeasurementDocs/ReadingValue,MeasurementDocs/IsCounterReading,MeasurementDocs/IsCounterReading,MeasurementDocs/ReadingTimestamp,MeasurementDocs/CounterReadingDifference,MeasurementDocs/MeasurementDocNum,MeasurementDocs/MeasuringPoint/CharName,MeasurementDocs/MeasuringPoint/IsCounter"
    },
    "Visible": "/SAPAssetManager/Rules/WCM/IsNotWCMOperator.js"
}