_to_online_service=Connessione al servizio online...\ntap_to_cancel=Tocca per annullare\nconnected_message=Connesso al servizio online\ndevice_already_registered=Terminale mobile già registrato\ndevice_already_registered_dialog_text=Un terminale mobile è già registrato; procedere con la registrazione di questo terminale per il TOTP?\nloading_dig_sig=Download dati firma digitale in corso\npending=In attesa\nsigned=Firmato\nNew=Nuovo\nNEW=NUOVO\ncurrent=Attuale\ncanceled=Annullato\nno_signatory_to_show=Nessun firmatario disponibile da mostrare\n#XMSG: Message text for passcode validation\npasscode_is_mandatory=Il codice di accesso è obbligatorio\n#XMSG: Message text for passcode length validation\npasscode_length=Il codice di accesso deve essere maggiore o uguale a 6 cifre.\n#Overview screen\n# XTIT: Overview recent list title\noverview_recent=Documenti materiale locali\n\n#Inbound List\n#XTIT: Inbound Documents list screen title\ninbound_list_title=Documenti in entrata\n\n#Inbound Documents\n# XFLD: Label for showing if an inbound document is completed\ninbound_document_completed=Ricevuto\n# XFLD: Label for showing if some of the inbound document items are received\ninbound_document_partial=Parzialmente ricevuto\n\n# XTIT: All documents list screen title\nall_documents_list_title=Tutti i documenti\n# XTIT: All documents label for tab item\nall_documents_label=Tutto\n\n#Outbound List\n# XTIT: Outbound Documents list screen title\noutbound_list_title=Documenti in uscita\n\n#Outbound Documents\n# XFLD: Label for showing if an outbound document is completed\noutbound_document_completed=Emesso\n# XFLD: Label for showing if an outbound document is open\nopen=Aperto\n# XFLD: Label for showing if an outbound document is open\nOPEN=Aperto\n# XFLD: Label for showing number of Open inbound/outbound items\nopen_x=Aperto ({0})\n# XFLD: Label for showing number of Issued outbound items\nissued_x=Emesso ({0})\n# XFLD: Label for showing if some of the outbound document items are iss