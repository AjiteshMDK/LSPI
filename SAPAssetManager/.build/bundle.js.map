y page\ndisapprove_workorder=Neschválit pracovní příkaz\n# XTIT: Caption for dissaproval reason entry page\ndisapprove_operation=Neschválit operaci\nworkorder_assigned_message=Pracovní příkaz byl úspěšně přiřazen\nworkorder_unassigned_message=Přiřazení pracovního příkazu bylo úspěšně zrušeno\noperation_assigned_message=Operace byla úspěšně přiřazena\noperation_unassigned_message=Přiřazení operace bylo úspěšně zrušeno\nedit_review=Upravit revizi\nrestart_workorder=Restartovat pracovní příkaz\nrestart_operation=Restartovat operaci\nunassigned=Nepřiřazeno\nworkorder_details=Detaily pracovního příkazu\n# XFLD: Label for the Order Details section\norder_details=Detaily zakázky\nothers=Jiné\nother=Jiné\ntech_note_caption=Poznámka technika pro supervizora\nsupervisor_note_caption=Poznámka supervizora pro technika\n#Digital Signature\ndevice_already_register=Zařízení je již registrované\nunregistering_device=Ruší se registrace zařízení...\nunregister_device=Zrušit registraci zařízení pro digitální podpisy\nunregister_device_successful=Registrace zařízení byla zrušena\ndevice_unregistration_failed=Nepodařilo se zrušit registraci zařízení\ndevice_not_register=Zařízení není registrované\nregister_digital_signature=Registrovat pro digitální podpisy\nregister_on_profile_settings=Chcete-li zařízení registrovat, klepněte na nastavení profilu.\nregister_passcode_screen=Počítadlo\nenter_passcode=Zadat bezpečnostní kód\npassphrase=Heslo\nenter_4_to_6_digit_number=Zadejte heslo složené z 4 až 6 číslic\nlaunch_authenticator=Spustit aplikaci Authenticator\ncreate_device=Vytváří se zařízení...\ndevice_created=Zařízení bylo úspěšně vytvořeno.\nget_passcode=Získat bezpečnostní kód\nregister_device=Zaregistrujte zařízení.\nregistering_device=Zařízení se registruje...\nauthenticator_ototp=Jednorázový bezpečnostní kód z aplikace Authenticator\ncreate_passphrase=Vytvořit heslo\nregister_device_message=Chcete zaregistrovat zařízení k použití jednorázového bezpečnostního kódu, který se bude používat pro digitální podpisy?\npassphrase_totp_help_text=Vytvořte si heslo o 4–6 číslicích, které si snadno zapamatujete. Toto heslo se zadává při zadávání digitálního podpisu.\n#YINS: Instructions on how to get TOTP from authenticator app (\"one-time passcode\" stands for authenticator app \"passcode\")\nregister_totp_help_text=Zkopírujte níže uvedený klíč a vložte jej jako klíč přípravy / tajný klíč do své preferované aplikace ověřovače. Tím se vygeneruje šestimístné jednorázové heslo. Vygenerované jednorázové heslo zkopírujte a vložte do pole jednorázového hesla uvedeného výše. Pokud nemáte aplikaci ověřovače, obraťte se na správce ohledně instalace.\n# XFLD: stands for authenticator app \"passcode\"\none_time_passcode=Jednorázové heslo\n# XFLD: stands for \"Get authenticator app \"passcode\"\"\nget_one_time_passcode=Získat jednorázové heslo\nenter_passphrase=Zadejte heslo nastavené při registraci\nadd_passphrase=Přidat heslo\nadd_passcode=Přidat bezpečnostní kód\nremark=Poznámka\nsignatory=Osoba odpovědná za platbu\ntime_stamp=Časový záznam\nadd_passcode_helpertext=Otevřete v zařízení aplikaci Authenticator. Zkopírujte bezpečnostní kód z aplikace Authenticator a vložte ho níže, nebo ho opište.\nadd_passphrase_helpertext=Heslo složené z 4-6 číslic, které jste vytvořili při registraci zařízení pro digitální podpisy.\ndigital_signature_successful=Podpis byl úspěšně vytvořen. Data se v tabulce podpisů projeví až při synchronizaci.\nmove_draft_to_db_failure=Nepodařilo se přesunout návrh do databáze\nmove_draft_to_db_success=Přesun návrhu do databáze byl úspěšný\npassphrase_is_mandatory=Heslo je povinné\npassphrase_length=Heslo musí mít 4 až 6 číslic\ncomment_is_mandatory=Komentář je povinný\nremark_is_mandatory=Poznámka je povinná\nconnecting_to_online_service=Připojování k online službě...\ntap_to_cancel=Klepnutím zrušit\nconnected_message=Připojeno k online službě\ndevice_already_registered=Zařízení je již registrované\ndevice_already_registered_dialog_text=Již existuje zaregistrované zařízení. Chcete pokračovat v registraci tohoto zařízení pro jednorázové heslo?\nloading_dig_sig=Stahují se data digitálního podpisu\npending=Nevyřízeno\nsigned=Podepsáno\nNew=Nové\nNEW=NOVÝ\ncurrent=Aktuální\ncanceled=Zrušeno\nno_signatory_to_show=Žádná dostupná podepisující osoba k zobrazení\n#XMSG: Message text for passcode validation\npasscode_is_mandatory=Bezpečnostní kód je povinný\n#XMSG: Message text for passcode length validation\npasscode_length=Bezpečnostní kód musí mít nejméně 6 číslic.\n#Overview screen\n# XTIT: Overview recent list title\noverview_recent=Lokální materiálové doklady\n\n#Inbound List\n#XTIT: Inbound Documents list screen title\ninbound_list_title=Příchozí doklady\n\n#Inbound Documents\n# XFLD: Label for showing if an inbound document is completed\ninbound_document_completed=Přijato\n# XFLD: Label for showing if some of the inbound document items are received\ninbound_document_partial=Částečně přijato\n\n# XTIT: All documents list screen title\nall_documents_list_title=Všechny doklady\n# XTIT: All documents label for tab item\nall_documents_label=Vše\n\n#Outbound List\n# XTIT: Outbound Documents list screen title\noutbound_list_title=Odchozí doklady\n\n#Outbound Documents\n# XFLD: Label for showing if an outbound document is completed\noutbound_document_completed=Vydáno\n# XFLD: Label for showing if an outbound document is open\nopen=Otevřít\n# XFLD: Label for showing if an outbound document is open\nOPEN=Otevřít\n# XFLD: Label for showing number of Open inbound/outbound items\nopen_x=Otevřeno ({0})\n# XFLD: Label for showing number of Issued outbound items\nissued_x=Vydáno ({0})\n# XFLD: Label for showing if some of the outbound document items are issued\noutbound_document_partial=Částečně vydáno\n\n#Physical Inventory\n#XTIT: Physical Inventory label for tab item\nphysical_inventory_label=Inventura\n#XTIT: Physical Inventory label for tab item\nphysical_inventory_label_x=Inventura ({0})\n\n#Inbound Delivery Detail\n# 