abel caption for CAUTION safety label\nforms_safety_caution=DİKKAT\n# XFLD: Label caption for NOTICE safety label\nforms_safety_notice=BİLDİRİM\n\n# SAP Dynamic Forms\n# XFLD: Label for showing SDF header\nsdf_sap_dynamic_forms=SAP Dynamic Forms\n# XFLD: Label for showing empty SDF header\nsdf_no_forms=Form yok\n# XTIT: Title for section/page headers\nsdf_section_caption=Formlar\n# XFLD: Label for mandatory forms\nsdf_mandatory=Zorunlu\n# XFLD: Label for optional forms\nsdf_optional=İsteğe bağlı\n# XMSG: Banner message when template doesn't exist\nsdf_template_not_found=Form şablonu bulunamadı\n# XMSG: Banner message when instance doesn't exist\nsdf_instance_not_found=Form örneği bulunamadı\n# XMSG: Error on dialog for completion when not in a completable state\nsdf_page_not_completable=Formu tamamlandı olarak işaretlemeden önce kaydedin.\n# XMSG: Error on dialog for saving when the page is in a completed or final state\nsdf_page_completed_or_final=Tamamlandı veya Final durumundaki formlar kaydedilemez\n# XFLD: Label for showing 'New' status\nsdf_status_new=Yeni\n# XFLD: Label for showing 'In Process' status\nsdf_status_in_process=İşleniyor\n# XFLD: Label for showing 'Completed' status\nsdf_status_completed=Tamamlandı\n# XFLD: Label for showing 'Reopened' status\nsdf_status_reopened=Yeniden açıldı\n# XFLD: Label for showing 'Final' status\nsdf_status_final=Final\n# XFLD: Label for form version\nsdf_form_version=Versiyon\n\n# Log Levels\n# XFLD: Label for showing log level: Error\nlog_level_error=Hata\n# XFLD: Label for showing log level: Debug\nlog_level_debug=Hata ayıklama\n# XFLD: Label for showing log level: Warn\nlog_level_warn=Uyarı\n# XFLD: Label for showing log level: Info\nlog_level_info=Bilgi\n# Label for Supply Plant\nsupply_plant=Tedarikçi üretim yeri\n#XFLD: Placeholder for no supplier material number field\npo_item_detail_no_supplier_material_number=SAS kalemi tedarikçi olmadan malzeme numarası\n# XTIT: Screen title for the Fetch Documents page\nfetch_d