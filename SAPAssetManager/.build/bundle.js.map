een title\nedit_service_order=แก้ไขใบสั่งงานบริการ\n# XTIT: section header title for service order details\nserviceorder_details=รายละเอียดการบริการ\n# XFLD: service order product field label\nservice_product=งานบริการ\n# XFLD: service order contract field label\nservice_contract=สัญญาการบริการ\n# XBUT: button text to start service order on botton toolbar of order detail page\nstart_serviceorder=เริ่มต้นใบสั่งงานบริการ\n# XBUT: button text to complete service order on botton toolbar of order detail page\nend_serviceorder=สิ้นสุดใบสั่งงานบริการ\n# XBUT: button text to restart service order on botton toolbar of order detail page\nrestart_serviceorder=เริ่มต้นใบสั่งงานบริการอีกครั้ง\n# XFLD: service order detail screen location field\nno_address_available=ไม่มีที่อยู่ที่พร้อมใช้งาน\n# XFLD: name of the field in the left sidebar menu\nservice_order_x=ใบสั่งงานบริการ ({0})\n# XFLD: name of the order field in the map\norder_x=ใบสั่งงานบริการ {0}\n# XFLD: name of the orders list in the map\norders=ใบสั่ง\n# XFLD: Label to show count of filtered service orders on list screen\nservice_order_x_x=ใบสั่งงานบริการ ({0}/{1})\n# XFLD: name of the field in the details page\nservice_request=คำขอรับบริการ\n# XFLD: name of the field in the left sidebar menu\nservice_request_x=คำขอรับบริการ ({0})\n# XFLD: name of the request details screen\nrequest_x=คำขอรับบริการ {0}\n# XFLD: Label to show count of filtered service reuqests on list screen\nservice_request_x_x=คำขอรับบริการ ({0}/{1})\n# XFLD: name of the field in the left sidebar menu\nexpenses=ค่าใช้จ่าย ({0})\n# XFLD: name of the field in the left sidebar menu\nservice_notifications_x=ใบแจ้งบริการ ({0})\n# XFLD: header for the component with SO for one day\ndate_dot_formatter={0} • {1}\n# XFLD: label in the header for service orders count with exact status\nnot_accepted=ยังไม่ยอมรับ\n# XFLD: label in the header for service orders count with exact status\nnot_started=ยังไม่เริ่มต้น\n# XFLD: label in the header for service orders count