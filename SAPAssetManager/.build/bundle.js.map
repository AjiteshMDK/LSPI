e Equipment List Picker\ninclude_from_reference_equipment=כולל מציוד סימוכין\ninstall_location=התקן מיקום\n#Add expense feature\n# XTIT: Title text for Add Expense screen\nadd_expense=הוסף הוצאה\n# XTIT: Title text for Edit Expense screen\nedit_expense=ערוך הוצאה\n# XFLD: Caption for Expense Type list picker\nexpense_type=סוג הוצאה\n# XFLD: Caption for Currencies list picker\ncurrencies=מטבעות\n# XTIT: Title text for Expense List screen\nexpense_list=רשימת הוצאות\n# XBTN: Add Another Expense text for button\nadd_another_expense=הוסף הוצאה נוספת\n# XMSG: Message text if expenses created\nexpenses_created=הוצאות נוצרו\n# XFLD: Empty Expenses table label\nno_expenses=לא נמצאו הוצאןת\n# XMSG: Confirmation message text if expenses should be removed\nconfirm_remove_expenses=כל ההוצאות שנוצרו בחלון עבודה זה יאבדו\n\n#XBUT: button text on the info panel in map page for Edit Geometry\naction_edit_geometry=ערוך גיאומטריה\n#XBUT: button text on the info panel in map page for Delete Geometry\naction_delete_geometry=מחק גיאומטריה\n\n# XFLD: Batch Number list picker label\nbatch_number=מספר סדרה\n# New FSM statuses\n# XFLD: Label for the Operations list item to display mobile status\nACCEPTED=התקבל\n# XBUT: Button text for popover menu item on  work order details page\ntravel=בנתיב\n# XFLD: Label for the Operations list item to display mobile status\nTRAVEL=בנתיב\n# XFLD: Label for the Operations list item to display mobile status\nONSITE=באתר\n#XFLD: label, which is used to show count of items, that are attached to current document\nitems_list_count=רשימת פריטים {0}\n#XFLD: field, which is used in Add Goods Receipt functionality\ngoods_recipient=מקבל טובין\n\n# XFLD: Label, which used to show count of documents on main page\nall_caption=הכול ({0})\n# XFLD: Label, which used to show count of filtered documents on main page\nall_caption_double=הכול ({0}/{1})\n\n# XMSG: Message text when downloading html created\ndownloading_html_template=מוריד תבנית HTML\n# XTIT: Title text for PD