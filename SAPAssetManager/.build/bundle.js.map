rvisor_note_caption=Ghi chú của Giám sát viên cho Kỹ thuật viên\n#Digital Signature\ndevice_already_register=Thiết bị đã đăng ký\nunregistering_device=Đang hủy đăng ký thiết bị...\nunregister_device=Hủy đăng ký thiết bị cho Chữ ký số\nunregister_device_successful=Đang hủy đăng ký thiết bị thành công\ndevice_unregistration_failed=Hủy đăng ký thiết bị không thành công\ndevice_not_register=Thiết bị không được đăng ký\nregister_digital_signature=Đăng ký chữ ký số\nregister_on_profile_settings=Để đăng ký thiết bị của bạn, hãy nhấp vào Thiết lập thông tin.\nregister_passcode_screen=Công tơ\nenter_passcode=Nhập mã truy cập\npassphrase=Cụm mật khẩu\nenter_4_to_6_digit_number=Nhập cụm mật khẩu 4 đến 6 chữ số\nlaunch_authenticator=Khởi chạy Ứng dụng xác thực\ncreate_device=Đang tạo thiết bị...\ndevice_created=Thiết bị đã tạo thành công.\nget_passcode=Nhận Mã truy cập\nregister_device=Đăng ký thiết bị.\nregistering_device=Đang đăng ký thiết bị...\nauthenticator_ototp=Mã truy cập một lần của Ứng dụng xác thực\ncreate_passphrase=Tạo cụm mật khẩu\nregister_device_message=Bạn có muốn đăng ký thiết bị này cho Mã truy cập một lần sẽ được sử dụng cho chữ ký điện tử không?\npassphrase_totp_help_text=Tạo cụm mật khẩu bằng số dễ nhớ bằng cách sử dụng 4-6 chữ số. Cụm mật khẩu được sử dụng khi nhập chữ ký điện tử.\n#YINS: Instructions on how to get TOTP from authenticator app (\"one-time passcode\" stands for authenticator app \"passcode\")\nregister_totp_help_text=Sao chép khóa bên dưới và dán nó làm khóa thiết lập / khóa mật trong Ứng dụng xác thực ưa thích của bạn. Thao tác này sẽ tạo một mã truy cập một lần với 6 chữ số. Sao chép và dán mã truy cập đã tạo này vào trường mã truy cập một lần ở trên để đăng ký. Nếu bạn không có Ứng dụng xác thực, hãy liên hệ với quản trị viên của bạn để thiết lập.\n# XFLD: stands for authenticator app \"passcode\"\none_time_passcode=Mã truy cập một lần\n# XFLD: stands for \"Get authenticator app \"passcode\"\"\nget_one_time_passcode=Nhận Mã truy cập một lần\nenter_passphrase=Nhập cụm mật khẩu đã thiết lập trước trong quá trình đăng ký\nadd_passphrase=Thêm Cụm mật khẩu\nadd_passcode=Thêm Mã truy cập\nremark=Nhận xét\nsignatory=Người ký kết\ntime_stamp=Dạng ngày tháng\nadd_passcode_helpertext=Mở Ứng dụng xác thực trên thiết bị của bạn. Sao chép mã truy cập từ Ứng dụng xác thực và dán vào bên dưới hoặc nhập thủ công.\nadd_passphrase_helpertext=Đây là cụm mật khẩu gồm 4-6 chữ số mà bạn đã tạo khi đăng ký thiết bị cho chữ ký số.\ndigital_signature_successful=Chữ ký đã được tạo thành công. Dữ liệu sẽ không phản ánh trong bảng chữ ký cho đến khi đồng bộ.\nmove_draft_to_db_failure=Chuyển bản nháp đến cơ sở dữ liệu không thành công\nmove_draft_to_db_success=Chuyển bản nháp đến cơ sở dữ liệu thành công\npassphrase_is_mandatory=Cụm mật khẩu là bắt buộc\npassphrase_length=Cụm mật khẩu phải gồm 4 đến 6 chữ số\ncomment_is_mandatory=Chú thích là bắt buộc\nremark_is_mandatory=Nhận xét là bắt buộc\nconnecting_to_online_service=Đang kết nối với dịch vụ trực tuyến...\ntap_to_cancel=Nhấp vào để hủy\nconnected_message=Đã kết nối với dịch vụ trực tuyến\ndevice_already_registered=Thiết bị đã đăng ký\ndevice_already_registered_dialog_text=Đã có một thiết bị được đăng ký, bạn có muốn tiếp tục đăng ký thiết bị này cho TOTP không?\nloading_dig_sig=Đang tải dữ liệu chữ ký số\npending=Đang chờ xử lý\nsigned=Đã ký\nNew=Mới\nNEW=MỚI\ncurrent=Hiện tại\ncanceled=Đã hủy\nno_signatory_to_show=Không có người ký kết nào để hiển thị\n#XMSG: Message text for passcode validation\npasscode_is_mandatory=Mã truy cập là bắt buộc\n#XMSG: Message text for passcode length validation\npasscode_length=Mã truy cập phải có ít nhất 6 chữ số\n#Overview screen\n# XTIT: Overview recent list title\noverview_recent=Chứng từ vật tư cục bộ\n\n#Inbound List\n#XTIT: Inbound Documents list screen title\ninbound_list_title=Chứng từ giao hàng về\n\n#Inbound Documents\n# XFLD: Label for showing if an inbound document is completed\ninbound_document_completed=Đã nhận\n# XFLD: Label for showing if some of the inbound document items are received\ninbound_document_partial=Đã nhận từng phần\n\n# XTIT: All documents list screen title\nall_documents_list_title=Tất cả chứng từ\n# XTIT: All documents label for tab item\nall_documents_label=Tất cả\n\n#Outbound List\n# XTIT: Outbound Documents list screen title\noutbound_list_title=Chứng từ giao hàng đi\n\n#Outbound Documents\n# XFLD: Label for showing if an outbound document is completed\noutbound_document_completed=Đã xuất\n# XFLD: Label for showing if an outbound document is open\nopen=Mở\n# XFLD: Label for showing if an outbound document is open\nOPEN=Mở\n# XFLD: Label for showing number of Open inbound/outbound items\nopen_x=Mở ({0})\n# XFLD: Label for showing number of Issued outbound items\nissued_x=Đã xuất ({0})\n# XFLD: Label for showing if some of the outbound document items are issued\noutbound_document_partial=Đã xuất từng phần\n\n#Physical Inventory\n#XTIT: Physical Inventory label for tab item\nphysical_inventory_label=Kiểm kê thực tế\n#XTIT: Physical Inventory label for tab item\nphysical_inventory_label_x=Kiểm kê thực tế({0})\n\n#Inbound Delivery Detail\n# XTIT: Inbound Delivery detail screen title\nibd_detail_title=Giao hàng về\n#XTIT: Inbound Delivery screen: Open Items section title\nibd_open_items=Mục chưa bù trừ\n# XTIT: Inbound Delivery Items screen title\ninbound_delivery_items_title=Mục giao hàng về\n\n#Inbound/outbound Delivery Header Fields\ncustomer=Khách hàng\ndelivery_priority=Ưu tiên giao hàng\ndelivery_type=Kiểu giao hàng\ndocument_category=Loại chứng từ\noverall_status=Trạng thái tổng thể\nshipping_point=Điểm chuyển hàng\nship_to_party=Bên nhận hàng