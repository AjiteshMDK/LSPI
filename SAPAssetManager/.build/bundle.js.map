่ได้อิมพลีเมนต์การควบคุม FormCell นี้\n#XMSG: Section type not supported warning\npure_data_section_text_block_text=ยังไม่ได้อิมพลีเมนต์ประเภทเซกชัน SectionedTable นี้\n#XFLD: Search placeholder\nsearch_textbox_default_placeholder_text=ค้นหา\n#XTIT: ListPicker Header for all items\nlist_picker_all_group_header_text=ทั้งหมด\n#XTIT: ListPicker Header for selected items\nlist_picker_selected_group_header=เลือกแล้ว\n#XTOL: Tooltip to export diagnostics (logs, settings, etc)\nexport_diagnostics_tool_tip_text=เอ็กซ์ปอร์ตการวิเคราะห์\n#XMSG: Authentication failed message\nauthentication_failed_error_text=การรับรองความถูกต้องล้มเหลว\n#XMSG: QR Code parsing failure\nqr_parsing_error_text=ไม่สามารถแยกวิเคราะห์รหัส QR\n#XMSG: Client initialization error\nclient_initialization_error_text=ไม่สามารถกำหนดค่าเริ่มต้นไคลเอนท์\n#XMSG: Wrong passcode error\npasscode_error_text=รหัสผ่านอุปกรณ์ไม่ถูกต้อง\n#XMSG: User settings loading error\nuser_settings_error_text=ไม่สามารถโหลด/เก็บบันทึกการกำหนดค่าผู้ใช้\n#XMSG: Passcode change error\nchange_passcode_error_text=ไม่สามารถเปลี่ยนรหัสผ่านอุปกรณ์\n#XMSG: Client policy apply error\napply_policies_error_text=ไม่สามารถนำนโยบายไคลเอนท์ไปใช้\n#XMSG: Client policy load error\nload_policies_error_text=ไม่สามารถโหลดนโยบายไคลเอนท์\n#XMSG: Empty with no data\ndata_table_empty_section_text=ไม่มีข้อมูล\n#XBUT: Signature Accept button text\nin_line_signature_capture_accept_button_content=เก็บบันทึก\n#XBUT: Signature Clear button text\nin_line_signature_capture_clear_button_content=ล้าง\n#XBUT: Signature Redo Button button text\nin_line_signature_capture_redo_button_content=ป้อนลายเซ็นอีกครั้ง\n#XMSG: Invalid QR code error\ninvalid_qr_code=รหัส QR ไม่ถูกต้อง\n#XMSG: QR code not found error\nqr_code_not_found_in_image=ไม่พบรหัส QR ในรูปภาพ\n#XBUT: Cancel Barcode scanning button text\ncapture_dialog_cancel_text_block_text=ยกเลิก\n#XTIT: Barcode scan header\nbarcode_capture_header_text=สแกนบาร์โค้ด\n#XBUT: Select file button text\nbarcode_capture_select_f