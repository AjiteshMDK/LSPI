{
	"Caption": "$(L,workorders_assign)",
    "OnLoaded": "/SAPAssetManager/Rules/Supervisor/Assign/WorkOrderAssignOnLoad.js",
    "OnActivityBackPressed": "/SAPAssetManager/Rules/WorkOrders/CreateUpdate/CancelCheckOnBackNavAndroid.js",
    "ActionBar": {
        "_Name": "WorkOrdersAssign",
        "Items":
        [{
            "Position": "Left",
            "_Name": "Cancel",
            "SystemItem": "Cancel",
            "Caption": "$(L,cancel)",
            "OnPress": "/SAPAssetManager/Actions/Page/CancelPage.action"
        },
        {
            "Position": "Right",
            "_Name": "Assign",
            "Text": "/SAPAssetManager/Rules/Supervisor/Assign/WorkOrderAssignButtonCaption.js",
            "OnPress": "/SAPAssetManager/Rules/Supervisor/Assign/WorkOrderAssignOnPress.js"
        }]
    },
    "Controls":
    [{
        "Sections":
        [{
            "Controls":
            [{
                "AllowMultipleSelection": true,
                "Caption": "$(L,workorder)",
                "IsVisible": "/SAPAssetManager/Rules/Supervisor/Assign/WorkOrderListPickerIsVisible.js",
                "Value": "/SAPAssetManager/Rules/WorkOrders/WorkOrderId.js",
                "OnValueChange": "/SAPAssetManager/Rules/Common/Validation/ResetValidationOnInput.js",
                "IsSelectedSectionEnabled": false,
                "PickerItems": {
                    "ObjectCell":
                    {
                        "PreserveIconStackSpacing": false,
                        "Title" : "{{#Property:OrderDescription}}",
                        "Subhead" : "{{#Property:OrderId}} - {{#Property:OrderType}}",
                        "Footnote" : "$(D,{{#Property:DueDate}})"
                    },
                    "ReturnValue" : "{{#Property:OrderId}}",
                    "Target":
                    {
                        "EntitySet" : "MyWorkOrderHeaders",
                        "Service" : "/SAPAssetManager/Services/AssetManager.service",
                        "QueryOptions": "/SAPAssetManager/Rules/Supervisor/Assign/WorkOrderPickItems.js"
                    }
                },
                "Search":
                {
                    "Enabled": true
                },
                "_Name": "WorkorderLstPkr",
                "_Type": "Control.Type.FormCell.ListPicker"
            },
            {
                "AllowMultipleSelection": false,
                "Caption": "$(L,assign_to)",
                "IsEditable": true,
                "IsSelectedSectionEnabled": false,
                "IsPickerDismissedOnSelection": true,
                "IsSearchCancelledAfterSelection": true,
                "PickerItems": {
                    "DisplayValue":"{{#Property:SAPUserId}} - {{#Property:UserNameLong}}",
                    "ReturnValue" : "{{#Property:PersonnelNo}}",
                    "Target":
                    {
                        "EntitySet" : "UserRoles",
                        "Service" : "/SAPAssetManager/Services/AssetManager.service",
                        "QueryOptions": "/SAPAssetManager/Rules/Supervisor/Assign/UserRolesAssignListPickerItems.js"
                    }
                },
                "Search":
                {
                    "Enabled": true
                },
                "OnValueChange": "/SAPAssetManager/Rules/Common/Validation/ResetValidationOnInput.js",
                "_Name": "AssignToLstPkr",
                "_Type": "Control.Type.FormCell.ListPicker"
            },
            {
                "_Type": "Control.Type.FormCell.Switch",
                "_Name": "ApprovalSwitch",
                "Caption": "$(L,approval_required)",
                "IsEditable": true,
                "IsVisible": false
            }]
        },
        {
            "Controls":
            [{
                "IsAutoResizing": false,
                "IsEditable": true,
                "Value": "",
                "Caption": "$(L,notes)",
                "PlaceHolder": "$(L,notes)",
                "_Name": "TransferNote",
                "_Type": "Control.Type.FormCell.Note"
            }]
        }],
        "_Name": "FormCellContainer",
        "_Type": "Control.Type.FormCellContainer"
    }],
	"_Name": "WorkOrderAssign",
	"_Type": "Page"
}