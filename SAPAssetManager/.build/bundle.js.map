ersion\nsdf_form_version=גרסה\n\n# Log Levels\n# XFLD: Label for showing log level: Error\nlog_level_error=שגיאה\n# XFLD: Label for showing log level: Debug\nlog_level_debug=בצע ניפוי שגיאות\n# XFLD: Label for showing log level: Warn\nlog_level_warn=אזהרה\n# XFLD: Label for showing log level: Info\nlog_level_info=מידע\n# Label for Supply Plant\nsupply_plant=ספק לאתר\n#XFLD: Placeholder for no supplier material number field\npo_item_detail_no_supplier_material_number=אין מספר חומר של ספק של פריט הזמנת רכש\n# XTIT: Screen title for the Fetch Documents page\nfetch_documents=הבא מסמכים\n# XFLD: Field Label for Custom Date Range field when searching inventory\ncustom_date_range=טווח תאריכים מותאמים\n# XTIT: KPI Item label that shows Today's Inbound Documents List\ntodays_inbound=המסמכים הנכנסים של היום\n# XTIT: KPI Item label that shows Today's Outbound Documents List\ntodays_outbound=המסמכים היוצאים של היום\n# XFLD: Field Label on inventory search page when no documents are available\nno_im_documents_available=אין מסמכים זמינים בתוצאה מקומית. לחץ על הסמל הבאה לחיפוש מסמכים מקוונים.\n# XBUT: Button label on inventory search page to fetch documents\nfetch=הבא\n\n# XFLD: Hint text for damage note\ndamage_text=טקסט נזק\n# XFLD: Hint text for cause note\ncause_text=טקסט סיבה\n# XBTN: use template text for note\nuse_template=השתמש בתבנית\n\n## Priority Assessment\n\n# XBUT: Navigate to priority assessment page\nassess_priority=הערך עדיפות\n# XFLD: Priority determined by assessment\nassessed_priority=עדיפות מוערכת\n# XFLD: highest priority consequence as determined by priority assessment\nleading_consequence=תוצאה מובילה\n# XFLD: highest priority likelihood as determined by priority assessment\nleading_likelihood=סבירות מובילה\n# XFLD: consequence of a particular action\nconsequence=תוצאה\n# XFLD: likelihood of a consequence occurring\nlikelihood=סבירות\n# XFLD: date when a work item should be finished\nfinal_due_date=תאריך יעד סופי\n# XBUT: clear all user-generated entries in